{
  "name": "inkling-tests",
  "private": true,
  "description": "Inkling: the app is built from src/ into index.html by build.js (no dependencies). Tests and formatting tools only.",
  "scripts": {
    "build": "node build.js",
    "check": "node build.js --check",
    "test": "node build.js && playwright test",
    "test:web": "node build.js && playwright test --project=web",
    "test:desktop": "node build.js && playwright test --project=desktop"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
