{
  "name": "inkling-desktop",
  "productName": "Inkling",
  "version": "1.8.0",
  "description": "Inkling, a novel-writing desk with a pet that cheers you on.",
  "author": "GoMunster",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --publish never"
  },
  "build": {
    "appId": "com.gomunster.inkling",
    "productName": "Inkling",
    "artifactName": "Inkling-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Inkling"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "A novel-writing desk with a pet that cheers you on",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "GoMunster",
      "repo": "inkling",
      "releaseType": "release"
    },
    "executableName": "inkling"
  },
  "repository": "github:GoMunster/inkling",
  "desktopName": "inkling.desktop",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
